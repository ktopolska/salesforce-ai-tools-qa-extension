    <recordLookups>
        <name>Get_Fallback_User</name>
        <label>Get Fallback User (Standard)</label>
        <locationX>572</locationX>
        <locationY>674</locationY>
        <connector>
            <targetReference>Create_VP_Task_Fallback</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
