<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <decisions>
        <name>Check_Amount_GT_100K</name>
        <label>Amount &gt; $100,000?</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Amount_Is_High_Value</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Amount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>100000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_VP_User</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_VP_User_Found</name>
        <label>VP User Found?</label>
        <locationX>440</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Get_Fallback_User</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>VP_User_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_VP_User</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_VP_Task_VP_User</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <formulas>
        <name>Formula_Description</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Description}), &quot;[Won on &quot; &amp; TEXT(TODAY()) &amp; &quot;]&quot;, &quot;[Won on &quot; &amp; TEXT(TODAY()) &amp; &quot;] &quot; &amp; {!$Record.Description})</expression>
    </formulas>
    <formulas>
        <name>Formula_DueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 7</expression>
    </formulas>
    <formulas>
        <name>Formula_OwnerTaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Follow up: Closed Won - &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>Formula_VPTaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;High-value deal closed: &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <label>Opportunity Closed Won Notification</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Owner_Task</name>
        <label>Create Owner Task</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <connector>
            <targetReference>Update_Opportunity_Description</targetReference>
        </connector>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>Formula_DueDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>Formula_OwnerTaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
